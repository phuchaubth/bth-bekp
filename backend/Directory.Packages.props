<Project>
  <ItemGroup>
    <!-- ASP.NET Core / EF Core: keep on the .NET 10 line -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.15" />
    <PackageVersion Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.15" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.15" />
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <!-- Sinh PDF. GIỮ Ở 6.2.4 (giấy phép MIT): từ 6.5.0 thư viện đổi sang AGPL-3.0, không phù hợp để triển khai tại bệnh viện. -->
    <PackageVersion Include="PDFsharp-MigraDoc" Version="6.2.4" />
    <!-- PDFsharp 6.2.4 kéo theo System.Security.Cryptography.Pkcs 8.0.1 (lỗ hổng GHSA-846f-f764-76mx): nâng lên bản đã vá. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <!-- Chỉ dùng trong test: kiểm tra file Excel xuất ra đúng chuẩn Office Open XML (giấy phép MIT). -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
  </ItemGroup>
</Project>
