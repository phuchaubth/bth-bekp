{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "Jwt": {
    "Issuer": "consent-management",
    "Audience": "consent-management-web",
    "SigningKey": "",
    "AccessTokenMinutes": 15
  },
  "DataProtection": {
    "FieldEncryptionKey": "",
    "BlindIndexKey": ""
  },
  "His": {
    "Provider": "None",
    "TimeoutSeconds": 5,
    "FakeLatencyMilliseconds": 150
  },
  "Auth": {
    "MaxFailedAttempts": 5,
    "LockoutMinutes": 15,
    "RefreshTokenLifetimeHours": 12,
    "RefreshReuseGraceSeconds": 30
  },
  "RateLimiting": {
    "AuthPermitLimit": 10,
    "RefreshPermitLimit": 30,
    "WindowSeconds": 60
  },
  "ReverseProxy": {
    "TrustAllProxies": false
  },
  "Seed": {
    "Enabled": false,
    "AdminUserName": "admin",
    "DemoData": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
