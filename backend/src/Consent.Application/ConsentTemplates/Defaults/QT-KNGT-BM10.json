  "sections": [
    {
      "title": "Phần người bệnh tự khai (Người bệnh thực hiện trước khi đến khám)\n(Patient self-declaration section)\n(To be completed by the patient prior to consultation)",
      "banner": true,
      "signer": "patient",
      "blocks": [
        {
          "type": "text",
          "key": "consultingRoom",
          "label": "Phòng khám (Consulting Room No.)",
          "required": true,
          "maxLength": 50
        },
        {
          "type": "paragraph",
          "heading": true,
          "text": "A - Nguy cơ té ngã (Fall risk)"
        },
        {
          "type": "choice",
          "key": "selfFallHistory",
          "label": "1. Tôi đã bị té ngã từ 2 lần trở lên trong 3 tháng qua (I have fallen 2 times or more in the past 3 months)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ]
        },
        {
          "type": "choice",
          "key": "selfMobilityAid",
          "label": "2. Tôi cần phải dùng nạng hoặc xe lăn hoặc cần có người dìu đỡ khi di chuyển (I require a cane, crutches, wheelchair, or assistance from another person when moving)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ]
        },
        {
          "type": "paragraph",
          "heading": true,
          "text": "B - Tầm soát bệnh lây nhiễm (dành cho những bệnh tạo thành dịch) (Infectious disease screening (for epidemic-prone diseases))"
        },
        {
          "type": "choice",
          "key": "infectionSymptoms",
          "label": "1. Triệu chứng: sốt kèm ho, đau họng, nổi mẫn hoặc mệt mỏi, đau đầu,... (Symptoms: fever with cough, sore throat, rash, fatigue, headache, etc.)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ]
        },
        {
          "type": "paragraph",
          "text": "Nếu “CÓ” câu 1 thì tiếp tục điền câu 2, 3 (If “YES” to Question 1, continue with Questions 2 and 3)"
        },
        {
          "type": "choice",
          "key": "epidemiologicalExposure",
          "label": "2. Dịch tễ: có yếu tố dịch tễ hay tiếp xúc với người đi từ vùng dịch trong vòng 15 ngày (Epidemiology: history of exposure or contact with individuals from epidemic areas within the past 15 days)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ],
          "visibleWhen": {
            "field": "infectionSymptoms",
            "in": [
              "yes"
            ]
          }
        },
        {
          "type": "choice",
          "key": "closeContact",
          "label": "3. Dịch tễ: tiếp xúc gần với người có từ 3 triệu chứng sốt, ho, khó thở, mệt mỏi,... (Epidemiology: close contact with a person presenting ≥3 symptoms: fever, cough, dyspnea, fatigue, etc.)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ],
          "visibleWhen": {
            "field": "infectionSymptoms",
            "in": [
              "yes"
            ]
          }
        },
        {
          "type": "paragraph",
          "text": "Nếu trả lời “CÓ” bất kỳ câu nào của mục A hoặc B, quý người bệnh cần đến bàn hướng dẫn để được hỗ trợ (If you answered “YES” to any question in Section A or B, please proceed to the guidance desk for assistance)."
        }
      ]
    },
    {
      "title": "Phần nhân viên bộ phận hướng dẫn thực hiện\n(Section for screening staff)",
      "banner": true,
      "newPage": true,
      "signer": "screeningStaff",
      "blocks": [
        {
          "type": "paragraph",
          "heading": true,
          "text": "A - Nguy cơ té ngã (Fall risk)"
        },
        {
          "type": "choice",
          "key": "staffMobilityAid",
          "label": "1. Người bệnh cần phải dùng nạng/xe lăn hay cần có người dìu đỡ khi di chuyển (The patient requires a cane/crutches/wheelchair or assistance from another person when moving)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ]
        },
        {
          "type": "choice",
          "key": "staffUnsteady",
          "label": "2. Người bệnh xanh tái, đang chóng mặt, loạng choạng, đứng không vững (The patient appears pale, is experiencing dizziness, staggering, or is unable to stand steadily)",
          "required": true,
          "layout": "row",
          "options": [
            {
              "value": "yes",
              "label": "Có (Yes)"
            },
            {
              "value": "no",
              "label": "Không (No)"
            }
          ]
        },
        {
          "type": "multiChoice",
          "key": "fallInterventions",
          "label": "Nếu trả lời “CÓ” 1 trong 2 hay cả 2 câu thì phải có hành động can thiệp (If the answer is “YES” to either question, staff must take intervention actions)",
          "options": [
            {
              "value": "mobilityAid",
              "label": "Cung cấp dụng cụ hỗ trợ di chuyển (Provide mobility aid devices)"
            },
            {
              "value": "assistAmbulation",
              "label": "Trợ giúp người bệnh di chuyển, đi lại nếu người bệnh không có thân nhân đi theo (Assist the patient with ambulation if not accompanied by a caregiver)"
            }
          ]
        },
        {
          "type": "paragraph",
          "heading": true,
          "text": "B - Tầm soát bệnh lây nhiễm (dành cho những bệnh tạo thành dịch) (Infectious disease screening (for epidemic-prone diseases))"
        },
        {
          "type": "choice",
          "key": "infectionAction",
          "label": "Nếu người bệnh chọn (If the patient selects)",
          "required": true,
          "options": [
            {
              "value": "referExposure",
              "label": "“CÓ” yếu tố dịch tễ kèm ít nhất 01 triệu chứng: chuyển người bệnh đến phòng khám sàng lọc (“YES” to an epidemiological risk factor plus at least one symptom: refer the patient to the screening clinic)"
            },
            {
              "value": "referSymptoms",
              "label": "“CÓ” từ 03 triệu chứng: chuyển người bệnh đến phòng khám sàng lọc (“YES” to 3 or more symptoms: refer the patient to the screening clinic)"
            },
            {
              "value": "maskContinue",
              "label": "“CÓ” dưới 03 triệu chứng: hướng dẫn người bệnh đeo khẩu trang và tiếp tục làm thủ tục (“YES” to fewer than 3 symptoms: advise the patient to wear a mask and continue the admission process)"
            }
          ],
          "visibleWhen": {
            "field": "infectionSymptoms",
            "in": [
              "yes"
            ]
          }
        }
      ]
    },
    {
      "title": "Phần điều dưỡng thực hiện\n(Section for nursing staff)",
      "banner": true,
      "newPage": true,
      "signer": "nurse",
      "blocks": [
        {
          "type": "paragraph",
          "heading": true,
          "text": "A. Dấu hiệu sinh tồn và các chỉ số đo lường (Vital signs and measurements)"
        },
        {
          "type": "text",
          "key": "pulse",
          "label": "Mạch (Pulse), lần/phút (beats/min)",
          "required": true,
          "maxLength": 3,
          "pattern": "^[0-9]{2,3}$",
          "patternMessage": "Nhập số lần/phút, ví dụ 80."
        },
        {
          "type": "text",
          "key": "temperature",
          "label": "Nhiệt độ (Temperature), °C",
          "required": true,
          "maxLength": 4,
          "pattern": "^[0-9]{2}([.,][0-9])?$",
          "patternMessage": "Nhập nhiệt độ, ví dụ 37 hoặc 37,5."
        },
        {
          "type": "text",
          "key": "bloodPressure",
          "label": "Huyết áp (Blood pressure), mmHg",
          "required": true,
          "maxLength": 7,
          "pattern": "^[0-9]{2,3}/[0-9]{2,3}$",
          "patternMessage": "Nhập theo dạng tâm thu/tâm trương, ví dụ 120/80."
        },
        {
          "type": "text",
          "key": "respiratoryRate",
          "label": "Nhịp thở (Respiratory rate), lần/phút (breaths/min)",
          "required": true,
          "maxLength": 3,
          "pattern": "^[0-9]{1,3}$",
          "patternMessage": "Nhập số lần/phút, ví dụ 18."
        },
        {
          "type": "text",
          "key": "spo2",
          "label": "SpO₂ – độ bão hòa oxy trong máu, khi có dấu hiệu khó thở (Blood oxygen saturation, if dyspnea is present), %",
          "maxLength": 3,
          "pattern": "^[0-9]{2,3}$",
          "patternMessage": "Nhập phần trăm, ví dụ 97."
        },
        {
          "type": "text",
          "key": "height",
          "label": "Chiều cao (Height), cm",
          "required": true,
          "maxLength": 5,
          "pattern": "^[0-9]{2,3}([.,][0-9])?$",
          "patternMessage": "Nhập chiều cao theo cm, ví dụ 165."
        },
        {
          "type": "text",
          "key": "weight",
          "label": "Cân nặng (Weight), kg",
          "required": true,
          "maxLength": 5,
          "pattern": "^[0-9]{1,3}([.,][0-9])?$",
          "patternMessage": "Nhập cân nặng theo kg, ví dụ 58 hoặc 58,5."
        },
        {
          "type": "computed",
          "key": "bmi",
          "label": "Chỉ số khối cơ thể (Body Mass Index), kg/m²",
          "formula": "bmi",
          "inputs": [
            "weight",
            "height"
          ]
        },
        {
          "type": "text",
          "key": "headCircumference",
          "label": "Vòng đầu, trẻ sơ sinh < 28 ngày tuổi (Head circumference, newborn < 28 days), cm",
          "maxLength": 4,
          "pattern": "^[0-9]{2}([.,][0-9])?$",
          "patternMessage": "Nhập vòng đầu theo cm, ví dụ 34."
        },
        {
          "type": "text",
          "key": "weight3MonthsAgo",
          "label": "Cân nặng 3 tháng trước, nếu có (Weight 3 months ago, if available), kg",
          "maxLength": 5,
          "pattern": "^[0-9]{1,3}([.,][0-9])?$",
          "patternMessage": "Nhập cân nặng theo kg."
        },
        {
          "type": "text",
          "key": "weightLossPercent",
          "label": "% sụt cân trong 3 tháng, nếu sụt cân (% weight loss over 3 months) = (cân nặng hiện tại – cân nặng 3 tháng trước)/cân nặng hiện tại",
          "maxLength": 5,
          "pattern": "^[0-9]{1,2}([.,][0-9]{1,2})?$",
          "patternMessage": "Nhập phần trăm, ví dụ 5,5."
