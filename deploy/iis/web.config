<?xml version="1.0" encoding="utf-8"?>
<!--
  web.config cho API khi chạy trên IIS (ASP.NET Core Hosting Bundle, chế độ in-process).
  Đặt file này cùng thư mục với Consent.Api.dll sau khi publish (dotnet publish đã sinh sẵn; bản này thêm các
  thiết lập an toàn). Bí mật KHÔNG đặt ở đây mà đặt trong biến môi trường của Application Pool (mục 4.2 docs/trien-khai.md).
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet"
                  arguments=".\Consent.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <!-- Các biến còn lại (ConnectionStrings__Default, Jwt__SigningKey, DataProtection__*, Storage__DocumentsPath…)
               đặt trong Application Pool > Advanced Settings > Environment Variables, hoặc ở cấp máy, để không lưu bí mật trong file. -->
        </environmentVariables>
      </aspNetCore>
      <security>
        <requestFiltering removeServerHeader="true">
          <!-- 2 MB, trùng giới hạn của API. -->
          <requestLimits maxAllowedContentLength="2097152" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
</configuration>
