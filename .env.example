# Sao chép thành .env (file .env KHÔNG được commit).
# Mật khẩu: tối thiểu 10 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.

# Mật khẩu tài khoản sa của SQL Server (container phát triển).
MSSQL_SA_PASSWORD=

# Khóa ký JWT, tối thiểu 32 ký tự ngẫu nhiên. Tạo bằng: openssl rand -base64 48
JWT_SIGNING_KEY=

# Khóa mã hóa dữ liệu nhạy cảm và khóa chỉ mục mù (hai khóa KHÁC nhau). Tạo mỗi khóa bằng: openssl rand -base64 32
# Mất khóa mã hóa = không đọc lại được số CCCD/SĐT/BHYT đã lưu. Sao lưu khóa an toàn, tách khỏi bản sao lưu CSDL.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=

# Mật khẩu tài khoản quản trị đầu tiên "admin" (không được chứa chữ "admin").
SEED_ADMIN_PASSWORD=

# Dữ liệu minh họa: khoa và tài khoản demo (bacsi.demo, dieuduong.demo, tiepdon.demo…) dùng chung mật khẩu dưới đây.
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=

ASPNETCORE_ENVIRONMENT=Development
WEB_PORT=8080
# Cổng SQL Server trên máy host (chỉ bind 127.0.0.1)
SQL_PORT=14333
